<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MediCare - Your Health, Our Priority</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600&family=Roboto&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <style>
        /* Reset */
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Roboto', sans-serif;
            color: #212529;
            background-color: #ffffff;
            line-height: 1.6;
        }

        a { text-decoration: none; color: inherit; }

        /* Header */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 50px;
            background-color: #ffffff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        header .logo {
            font-family: 'Poppins', sans-serif;
            font-size: 1.6rem;
            color: #007BFF;
            font-weight: 600;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 25px;
        }

        nav ul li a {
            font-weight: 500;
            transition: color 0.3s;
        }

        nav ul li a:hover { color: #0056b3; }

        .cta-btn {
            padding: 10px 20px;
            background-color: #007BFF;
            color: #ffffff;
            border-radius: 5px;
            font-weight: 500;
            transition: background-color 0.3s;
        }

        .cta-btn:hover { background-color: #0056b3; }

        /* Hero Section */
        .hero {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: 120px 20px;
            background: linear-gradient(180deg, #ffffff 0%, #e6f0ff 100%);
        }

        .hero h1 {
            font-family: 'Poppins', sans-serif;
            font-size: 2.8rem;
            color: #007BFF;
            margin-bottom: 20px;
        }

        .hero p {
            font-size: 1.2rem;
            margin-bottom: 30px;
        }

        .hero-buttons {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }

        .hero-buttons .btn-secondary {
            background-color: #ffffff;
            border: 2px solid #007BFF;
            color: #007BFF;
        }

        .hero-buttons .btn-secondary:hover {
            background-color: #007BFF;
            color: #ffffff;
        }

        /* Services Section */
        .services {
            padding: 80px 50px;
            text-align: center;
        }

        .services h2 {
            font-family: 'Poppins', sans-serif;
            font-size: 2rem;
            color: #007BFF;
            margin-bottom: 50px;
        }

        .service-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 30px;
        }

        .service-card {
            padding: 30px 20px;
            border-radius: 15px;
            background-color: #ffffff;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .service-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 25px rgba(0,0,0,0.1);
        }

        .service-card i {
            font-size: 3rem;
            color: #007BFF;
            margin-bottom: 20px;
        }

        .service-card h3 {
            font-family: 'Poppins', sans-serif;
            color: #0056b3;
            margin-bottom: 10px;
        }

        .service-card p { font-size: 0.95rem; }

        /* Doctors Section */
        .doctors {
            background-color: #f8f9fa;
            padding: 80px 50px;
            text-align: center;
        }

        .doctors h2 {
            font-family: 'Poppins', sans-serif;
            font-size: 2rem;
            color: #007BFF;
            margin-bottom: 50px;
        }

        .doctor-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 30px;
        }

        .doctor-card {
            background-color: #ffffff;
            border-radius: 15px;
            padding: 20px;
            text-align: center;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .doctor-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 25px rgba(0,0,0,0.1);
        }

        .doctor-card img {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            margin-bottom: 15px;
            object-fit: cover;
        }

        .doctor-card h3 {
            font-family: 'Poppins', sans-serif;
            margin-bottom: 5px;
            color: #0056b3;
        }

        .doctor-card p { font-size: 0.95rem; margin-bottom: 15px; }

        .doctor-card button {
            padding: 10px 20px;
            border: 2px solid #007BFF;
            border-radius: 5px;
            background-color: #ffffff;
            color: #007BFF;
            cursor: pointer;
            transition: background-color 0.3s, color 0.3s;
        }

        .doctor-card button:hover {
            background-color: #007BFF;
            color: #ffffff;
        }

        /* Appointment Form */
        .appointment {
            padding: 80px 50px;
            text-align: center;
        }

        .appointment h2 {
            font-family: 'Poppins', sans-serif;
            font-size: 2rem;
            color: #007BFF;
            margin-bottom: 40px;
        }

        .appointment form {
            max-width: 600px;
            margin: auto;
            display: grid;
            gap: 20px;
        }

        .appointment input,
        .appointment textarea {
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #ccc;
            width: 100%;
            font-size: 1rem;
        }

        .appointment button {
            padding: 12px;
            background-color: #007BFF;
            color: #ffffff;
            font-weight: 500;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        .appointment button:hover { background-color: #0056b3; }

        /* Footer */
        footer {
            background-color: #0056b3;
            color: #ffffff;
            padding: 50px;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 20px;
        }

        footer h3 { margin-bottom: 15px; }

        footer a { color: #ffffff; transition: color 0.3s; }
        footer a:hover { color: #e0e0e0; }

        footer p { margin-bottom: 10px; }

        /* Responsive */
        @media (max-width: 768px) {
            header { flex-direction: column; align-items: flex-start; gap: 15px; }
            .hero { padding: 70px 20px; }
            .services, .doctors, .appointment { padding: 60px 20px; }
            footer { flex-direction: column; align-items: flex-start; }
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header>
        <div class="logo">MediCare</div>
        <nav>
            <ul>
                <li><a href="#">Home</a></li>
                <li><a href="#">Services</a></li>
                <li><a href="#">Doctors</a></li>
                <li><a href="#">About Us</a></li>
                <li><a href="#">Contact</a></li>
            </ul>
        </nav>
        <a href="#" class="cta-btn">Book Appointment</a>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <h1>Your Health, Our Priority</h1>
        <p>Professional care, trusted by thousands of patients.</p>
        <div class="hero-buttons">
            <a href="#" class="cta-btn">Book Appointment</a>
            <a href="#" class="btn-secondary">Learn More</a>
        </div>
    </section>

    <!-- Services Section -->
    <section class="services">
        <h2>Our Services</h2>
        <div class="service-cards">
            <div class="service-card">
                <i class="fas fa-heartbeat"></i>
                <h3>Cardiology</h3>
                <p>Expert heart care and treatment for all ages.</p>
            </div>
            <div class="service-card">
                <i class="fas fa-baby"></i>
                <h3>Pediatrics</h3>
                <p>Comprehensive child healthcare services.</p>
            </div>
            <div class="service-card">
                <i class="fas fa-brain"></i>
                <h3>Neurology</h3>
                <p>Advanced diagnosis and treatment of brain disorders.</p>
            </div>
            <div class="service-card">
                <i class="fas fa-x-ray"></i>
                <h3>Radiology</h3>
                <p>High-quality imaging and diagnostics services.</p>
            </div>
        </div>
    </section>

    <!-- Doctors Section -->
    <section class="doctors">
        <h2>Meet Our Doctors</h2>
        <div class="doctor-cards">
            <div class="doctor-card">
                <img src="https://randomuser.me/api/portraits/men/32.jpg" alt="Dr. John Smith">
                <h3>Dr. John Smith</h3>
                <p>Cardiologist</p>
                <button>View Profile</button>
            </div>
            <div class="doctor-card">
                <img src="https://randomuser.me/api/portraits/women/44.jpg" alt="Dr. Emily Rose">
                <h3>Dr. Emily Rose</h3>
                <p>Pediatrician</p>
                <button>View Profile</button>
            </div>
            <div class="doctor-card">
                <img src="https://randomuser.me/api/portraits/men/76.jpg" alt="Dr. Alan Wong">
                <h3>Dr. Alan Wong</h3>
                <p>Neurologist</p>
                <button>View Profile</button>
            </div>
        </div>
    </section>

    <!-- Appointment Form -->
    <section class="appointment">
        <h2>Book an Appointment</h2>
        <form>
            <input type="text" placeholder="Full Name" required>
            <input type="email" placeholder="Email Address" required>
            <input type="tel" placeholder="Phone Number" required>
            <input type="date" placeholder="Preferred Date" required>
            <textarea rows="4" placeholder="Message"></textarea>
            <button type="submit">Submit</button>
        </form>
    </section>

    <!-- Footer -->
    <footer>
        <div>
            <h3>Quick Links</h3>
            <p><a href="#">Home</a></p>
            <p><a href="#">Services</a></p>
            <p><a href="#">Doctors</a></p>
            <p><a href="#">Contact</a></p>
        </div>
        <div>
            <h3>Contact Info</h3>
            <p>Phone: +234 123 4567</p>
            <p>Email: info@medicare.com</p>
            <p>Address: Multipurpose Hall, Kudenda, Kaduna</p>
        </div>
        <div>
            <h3>Follow Us</h3>
            <p><a href="#">Facebook</a> | <a href="#">Twitter</a> | <a href="#">Instagram</a></p>
        </div>
    </footer>

</body>
</html>
